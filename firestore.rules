rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla general: Requiere que el usuario esté autenticado en Firebase
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Colección de Usuarios y Roles
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Colección de Estudiantes (Residentes y Fellows)
    match /estudiantes/{estudianteId} {
      allow read, write: if request.auth != null;
    }
    
    // Colección de Evaluaciones
    match /evaluaciones/{evaluacionId} {
      allow read, write: if request.auth != null;
    }
  }
}
